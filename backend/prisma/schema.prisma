generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum SubscriptionTier {
  FREE
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  TRIAL
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  name      String
  
  // Subscription
  subscriptionTier    SubscriptionTier   @default(FREE)
  subscriptionStatus  SubscriptionStatus @default(ACTIVE)
  subscriptionEndsAt  DateTime?
  messagesUsed        Int                @default(0)
  messagesLimit       Int                @default(50)
  
  // WhatsApp (User's number)
  whatsappNumber      String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  forwardingRules ForwardingRule[]
  logs            ForwardingLog[]
}

model ForwardingRule {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name        String
  isActive    Boolean  @default(true)
  
  // Email Configuration (User provides)
  emailUser     String
  emailPassword String
  emailHost     String  @default("imap.gmail.com")
  emailPort     Int     @default(993)
  emailTls      Boolean @default(true)
  
  // Email Filters
  filterSubjects String[] @default([])
  filterSenders  String[] @default([])
  filterHours    Int      @default(24)
  
  // Schedule
  cronSchedule String @default("*/10 * * * *")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  logs ForwardingLog[]
}

model ForwardingLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  ruleId    String   @db.ObjectId
  rule      ForwardingRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  
  emailSubject String
  emailFrom    String
  emailDate    DateTime
  
  status       String
  error        String?
  
  createdAt    DateTime @default(now())
}