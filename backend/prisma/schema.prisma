generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  forwardingRules ForwardingRule[]
  logs            ForwardingLog[]
}

model ForwardingRule {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name        String
  isActive    Boolean  @default(true)
  
  // Email Configuration
  emailUser     String
  emailPassword String
  emailHost     String  @default("imap.gmail.com")
  emailPort     Int     @default(993)
  emailTls      Boolean @default(true)
  
  // Email Filters
  filterSubjects String[] @default([])
  filterSenders  String[] @default([])
  filterHours    Int      @default(24)
  
  // Twilio Configuration
  twilioAccountSid String
  twilioAuthToken  String
  whatsappSender   String
  whatsappRecipient String
  
  // Schedule
  cronSchedule String @default("*/10 * * * *")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  logs ForwardingLog[]
  
  @@index([userId, isActive])
}

model ForwardingLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  ruleId    String
  rule      ForwardingRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  
  emailSubject String
  emailFrom    String
  emailDate    DateTime
  
  status       String   // 'success', 'failed'
  error        String?
  
  createdAt    DateTime @default(now())
  
  @@index([userId, createdAt])
  @@index([ruleId, createdAt])
}